import Mathlib

/-!
# Concrete simple-cubic geometry and constructive entropy lower bound

This module narrows the Python-to-Lean trust boundary of the cubic HP
parity-obstruction certificate. It defines exact integer lattice sites,
six unit directions, a concrete lattice-edge relation, and the actual
parity coloring of x+y+z. It proves that ANY rooted lattice walk
alternates spatial parity with the index, and hence H residues all
on one sequence-index parity cannot touch across a lattice edge.

Separately, a walk generated by a word of +x,+y,+z directions is
self-avoiding. Distinct direction words give distinct rooted indexed
walks, so this constructs exponentially many distinct conformations.

The theorem concerns the precisely specified simple-cubic lattice HP
model, not physical proteins. Its embedding into the Python data
decoder and full partition-mass computation remains an explicit open
trust boundary; no claim to atomistic validation is made.
-/

namespace FoldBounds.CubicParityGeometry

structure Site3 where
  x : ℤ
  y : ℤ
  z : ℤ
  deriving DecidableEq, Repr

def origin : Site3 := ⟨0, 0, 0⟩
def first : Site3 := ⟨1, 0, 0⟩

def height (p : Site3) : ℤ := p.x + p.y + p.z
def color (p : Site3) : ℤ := (height p) % 2

/-- Exactly six oriented cubic nearest-neighbor edges. -/
def advance (p : Site3) (d : Fin 6) : Site3 :=
  if d = 0 then ⟨p.x + 1, p.y, p.z⟩
  else if d = 1 then ⟨p.x - 1, p.y, p.z⟩
  else if d = 2 then ⟨p.x, p.y + 1, p.z⟩
  else if d = 3 then ⟨p.x, p.y - 1, p.z⟩
  else if d = 4 then ⟨p.x, p.y, p.z + 1⟩
  else ⟨p.x, p.y, p.z - 1⟩

def Adjacent (p q : Site3) : Prop :=
  ∃ d : Fin 6, advance p d = q

/-- Each of the six concrete lattice steps changes spatial parity. -/
theorem advance_color_flip (p : Site3) (d : Fin 6) :
    color (advance p d) = (color p + 1) % 2 := by
  fin_cases d <;> simp [advance, color, height] <;> omega

theorem adjacent_color_flip (p q : Site3) (h : Adjacent p q) :
    color q = (color p + 1) % 2 := by
  rcases h with ⟨d, hd⟩
  rw [← hd]
  exact advance_color_flip p d

theorem color_range (p : Site3) : 0 ≤ color p ∧ color p < 2 := by
  dsimp [color]
  omega

/-- An actual cubic nearest-neighbor edge cannot join equal colors. -/
theorem adjacent_changes_color (p q : Site3) (h : Adjacent p q) :
    color p ≠ color q := by
  have hc := adjacent_color_flip p q h
  have hp := color_range p
  have hq := color_range q
  omega

/-- Every legal walk, even one not assumed self-avoiding, obeys
the concrete cubic position/index parity identity. -/
theorem walk_index_parity (walk : ℕ → Site3)
    (hstart : walk 0 = origin)
    (hsteps : ∀ i, Adjacent (walk i) (walk (i + 1)))
    (i : ℕ) : color (walk i) = (i : ℤ) % 2 := by
  induction i with
  | zero =>
      simp [hstart, color, height, origin]
  | succ i ih =>
      have hs := adjacent_color_flip (walk i) (walk (i + 1)) (hsteps i)
      rw [hs, ih]
      omega

/-- **Concrete 3D HP parity no-go**: if every H index has the same
integer parity, there is no possible nearest-neighbor H-H contact
on any legal cubic walk, at any pair of indices. -/
theorem no_hh_contact_same_index_parity
    (walk : ℕ → Site3)
    (hstart : walk 0 = origin)
    (hsteps : ∀ i, Adjacent (walk i) (walk (i + 1)))
    (isH : ℕ → Prop) (chosen : ℤ)
    (hH : ∀ i, isH i → (i : ℤ) % 2 = chosen)
    (i j : ℕ) (hi : isH i) (hj : isH j) :
    ¬ Adjacent (walk i) (walk j) := by
  intro edge
  have hne := adjacent_changes_color (walk i) (walk j) edge
  have heq : color (walk i) = color (walk j) := by
    calc
      color (walk i) = (i : ℤ) % 2 := walk_index_parity walk hstart hsteps i
      _ = chosen := hH i hi
      _ = (j : ℤ) % 2 := (hH j hj).symm
      _ = color (walk j) := (walk_index_parity walk hstart hsteps j).symm
  exact hne heq

/-- Position/index parity holds even for a FINITE walk that might
be trapped and have no infinite self-avoiding continuation.
The step premise is needed only within the first \`length\` sites. -/
theorem finite_walk_index_parity
    (walk : ℕ → Site3) (length : ℕ)
    (hstart : walk 0 = origin)
    (hsteps : ∀ i, i + 1 < length →
      Adjacent (walk i) (walk (i + 1)))
    (i : ℕ) (hi : i < length) :
    color (walk i) = (i : ℤ) % 2 := by
  have h : ∀ j : ℕ, j < length →
      color (walk j) = (j : ℤ) % 2 := by
    intro j
    induction j with
    | zero =>
        intro hj
        simp [hstart, color, height, origin]
    | succ j ih =>
        intro hj
        have hprev : j < length := by omega
        have hf := adjacent_color_flip (walk j) (walk (j + 1))
          (hsteps j hj)
        rw [hf, ih hprev]
        omega
  exact h i hi

/-- A finite rooted, stepwise-adjacent cubic walk cannot have an
H-H lattice edge when all hydrophobic sequence indices have one
common parity. This is the form used by finite SAW ensembles. -/
theorem finite_no_hh_contact_same_index_parity
    (walk : ℕ → Site3) (length : ℕ)
    (hstart : walk 0 = origin)
    (hsteps : ∀ i, i + 1 < length →
      Adjacent (walk i) (walk (i + 1)))
    (isH : ℕ → Prop) (chosen : ℤ)
    (hH : ∀ i, i < length → isH i → (i : ℤ) % 2 = chosen)
    (i j : ℕ) (hi : i < length) (hj : j < length)
    (hHi : isH i) (hHj : isH j) :
    ¬ Adjacent (walk i) (walk j) := by
  intro edge
  have hne := adjacent_changes_color (walk i) (walk j) edge
  have heq : color (walk i) = color (walk j) := by
    calc
      color (walk i) = (i : ℤ) % 2 :=
        finite_walk_index_parity walk length hstart hsteps i hi
      _ = chosen := hH i hi hHi
      _ = (j : ℤ) % 2 := (hH j hj hHj).symm
      _ = color (walk j) :=
        (finite_walk_index_parity walk length hstart hsteps j hj).symm
  exact hne heq

/-- Three positive-axis steps, enough to generate a large explicit
subset of globally self-avoiding cubic walks. -/
def advancePositive (p : Site3) (d : Fin 3) : Site3 :=
  if d = 0 then ⟨p.x + 1, p.y, p.z⟩
  else if d = 1 then ⟨p.x, p.y + 1, p.z⟩
  else ⟨p.x, p.y, p.z + 1⟩

theorem positive_step_height (p : Site3) (d : Fin 3) :
    height (advancePositive p d) = height p + 1 := by
  fin_cases d <;> simp [advancePositive, height] <;> omega

theorem positive_step_injective (p : Site3) :
    Function.Injective (advancePositive p) := by
  intro d e h
  fin_cases d <;> fin_cases e <;> simp_all [advancePositive] <;> omega

/-- Full successor site trace for a chosen direction word. -/
def tracePositive (p : Site3) : List (Fin 3) → List Site3
  | [] => []
  | d :: ds =>
      let next := advancePositive p d
      next :: tracePositive next ds

def walkPositive (ds : List (Fin 3)) : List Site3 :=
  [origin, first] ++ tracePositive first ds

/-- The position of the next vertex completely determines which of
+x,+y,+z was chosen. By induction, complete traces decode uniquely. -/
theorem tracePositive_injective (p : Site3) :
    Function.Injective (tracePositive p) := by
  intro ds es h
  induction ds generalizing p es with
  | nil =>
      cases es with
      | nil => rfl
      | cons e es => simp [tracePositive] at h
  | cons d ds ih =>
      cases es with
      | nil => simp [tracePositive] at h
      | cons e es =>
          simp only [tracePositive, List.cons.injEq] at h
          rcases h with ⟨hhead, htail⟩
          have he : d = e := positive_step_injective p hhead
          subst e
          have ht : ds = es := ih (advancePositive p d) htail
          simp [ht]

theorem walkPositive_injective :
    Function.Injective walkPositive := by
  intro ds es h
  have ht : tracePositive first ds = tracePositive first es := by
    simpa [walkPositive] using h
  exact tracePositive_injective first ht

/-- Every successor in a positive-axis trace lies at strictly greater
coordinate sum than its starting site. -/
theorem tracePositive_height_gt (p q : Site3) (ds : List (Fin 3))
    (hq : q ∈ tracePositive p ds) : height p < height q := by
  induction ds generalizing p with
  | nil => simp [tracePositive] at hq
  | cons d ds ih =>
      simp only [tracePositive, List.mem_cons] at hq
      rcases hq with h | h
      · rw [h]
        have hs := positive_step_height p d
        omega
      · have hs := positive_step_height p d
        have hh := ih (advancePositive p d) h
        omega

/-- Every positive-axis trace is self-avoiding, not merely injectively
coded. The proof uses strictly increasing lattice coordinate sum. -/
theorem tracePositive_nodup (p : Site3) (ds : List (Fin 3)) :
    (p :: tracePositive p ds).Nodup := by
  induction ds generalizing p with
  | nil => simp [tracePositive]
  | cons d ds ih =>
      change (p :: advancePositive p d ::
        tracePositive (advancePositive p d) ds).Nodup
      apply List.nodup_cons.mpr
      constructor
      · intro h
        simp only [List.mem_cons] at h
        rcases h with h | h
        · have hs := positive_step_height p d
          have hheight := congrArg height h
          omega
        · have hs := positive_step_height p d
          have hh := tracePositive_height_gt (advancePositive p d) p ds h
          omega
      · exact ih (advancePositive p d)

theorem walkPositive_nodup (ds : List (Fin 3)) :
    (walkPositive ds).Nodup := by
  have htail := tracePositive_nodup first ds
  have horigin : origin ∉ (first :: tracePositive first ds) := by
    intro h
    simp only [List.mem_cons] at h
    rcases h with h | h
    · simp [origin, first] at h
    · have hh := tracePositive_height_gt first origin ds h
      simp [first, origin, height] at hh
  have hno : (origin :: first :: tracePositive first ds).Nodup :=
    List.nodup_cons.mpr ⟨horigin, htail⟩
  simpa [walkPositive] using hno

theorem tracePositive_length (p : Site3) (ds : List (Fin 3)) :
    (tracePositive p ds).length = ds.length := by
  induction ds generalizing p with
  | nil => rfl
  | cons d ds ih => simp [tracePositive, ih]

theorem walkPositive_length (ds : List (Fin 3)) :
    (walkPositive ds).length = ds.length + 2 := by
  simp [walkPositive, tracePositive_length]

/-- The monotone words have precisely 3^k different encodings.
The injective image theorem, unlike a finite-k sample, is valid for
every k without traversing a huge state space. -/
theorem monotone_word_injective (k : ℕ) :
    Function.Injective
      (fun w : Fin k → Fin 3 => walkPositive (List.ofFn w)) := by
  intro w v h
  have hlist := walkPositive_injective h
  exact List.ofFn_injective hlist

theorem monotone_family_card (k : ℕ) :
    ((Finset.univ : Finset (Fin k → Fin 3)).image
      (fun w => walkPositive (List.ofFn w))).card = 3 ^ k := by
  rw [Finset.card_image_of_injective _ (monotone_word_injective k)]
  simp

theorem monotone_family_valid (k : ℕ) (w : Fin k → Fin 3) :
    (walkPositive (List.ofFn w)).Nodup ∧
      (walkPositive (List.ofFn w)).length = k + 2 := by
  constructor
  · exact walkPositive_nodup _
  · simpa using walkPositive_length (List.ofFn w)

-- Concrete compile-time checks for the six cardinal directions.
example : Adjacent origin first := by
  refine ⟨0, ?_⟩
  decide

example : ¬ Adjacent origin (⟨2, 0, 0⟩ : Site3) := by
  intro h
  rcases h with ⟨d, hd⟩
  fin_cases d <;> simp [advance, origin] at hd

