module

public import Mathlib

/-!
# Exact linear-separation certificates for correlated contact uncertainty

An uncertain contact is generated by SHARED coordinate perturbations, not an
independent Boolean variable. After exact expansion of squared distances,
contact-on and contact-off requirements imply finite rational *linear*
inequalities on the same coordinate perturbations. If a nonnegative linear
combination of these inequalities contradicts the coordinate box, the entire
contact-state assignment is impossible.

This module proves the generic rational soundness, not the parsing of deposited
PDB/NPZ files or the entire 124-residue instance. A separate independent
integer/rational verifier checks the concrete source-only Farkas multipliers.
-/

@[expose] public section
namespace FoldBounds.MotionGNMGeometricNogoods

/-- An exact support-function bound for a rational coordinate box. -/
theorem box_linear_lower {m : ℕ} (eps : ℚ)
    (a delta : Fin m → ℚ) (hbox : ∀ j, |delta j| ≤ eps) :
    -(eps * (∑ j, |a j|)) ≤ ∑ j, a j * delta j := by
  have term : ∀ j : Fin m, -(eps * |a j|) ≤ a j * delta j := by
    intro j
    have hmul : |a j * delta j| ≤ |a j| * eps := by
      rw [abs_mul]
      exact mul_le_mul_of_nonneg_left (hbox j) (abs_nonneg (a j))
    have hneg : -|a j * delta j| ≤ a j * delta j := neg_abs_le _
    nlinarith
  have hsum : (∑ j : Fin m, -(eps * |a j|)) ≤
      ∑ j : Fin m, a j * delta j := by
    exact Finset.sum_le_sum (fun j _ => term j)
  simpa [Finset.mul_sum, Finset.sum_neg_distrib] using hsum

/-- Purely rational, executable-style separating condition. No optimizer is
part of the trusted theorem. -/
def checkLinearNoGood {m : ℕ} (eps : ℚ) (a : Fin m → ℚ)
    (rhs : ℚ) : Bool :=
  decide (0 ≤ eps ∧ rhs < -(eps * (∑ j, |a j|)))

/-- If the accepted exact Farkas separation contradicts the box's support
function, no point in the box can satisfy the proposed linear inequality. -/
theorem checkLinearNoGood_sound {m : ℕ} (eps : ℚ)
    (a delta : Fin m → ℚ) (rhs : ℚ)
    (hgate : checkLinearNoGood eps a rhs = true)
    (hbox : ∀ j, |delta j| ≤ eps)
    (hlinear : (∑ j, a j * delta j) ≤ rhs) : False := by
  have hsep := (of_decide_eq_true hgate).2
  have hlow := box_linear_lower eps a delta hbox
  linarith

/-- Exact expansion of squared distances: no floating truncation is used. -/
theorem contact_distance_expansion {m : ℕ} (r delta : Fin m → ℚ) :
    (∑ j, (r j + delta j) ^ 2) =
      (∑ j, r j ^ 2) + 2 * (∑ j, r j * delta j) +
      (∑ j, delta j ^ 2) := by
  simp_rw [add_sq]
  simp [Finset.sum_add_distrib, Finset.mul_sum]
  ring

/-- An active contact gives a *necessary* linear inequality. It can be
relaxed, but can never exclude a truly realized contact. -/
theorem contact_on_necessary {m : ℕ} (r delta : Fin m → ℚ)
    (cutoffSq : ℚ)
    (hon : (∑ j, (r j + delta j) ^ 2) ≤ cutoffSq) :
    2 * (∑ j, r j * delta j) ≤
      cutoffSq - (∑ j, r j ^ 2) := by
  have hquad : 0 ≤ (∑ j, delta j ^ 2) := by
    exact Finset.sum_nonneg (fun j _ => sq_nonneg (delta j))
  have heq := contact_distance_expansion r delta
  linarith

/-- An inactive contact gives a second necessary linear inequality, using
an upper bound on the quadratic displacement remainder. -/
theorem contact_off_necessary {m : ℕ} (r delta : Fin m → ℚ)
    (cutoffSq cap : ℚ)
    (hoff : cutoffSq ≤ (∑ j, (r j + delta j) ^ 2))
    (hcap : (∑ j, delta j ^ 2) ≤ cap) :
    -(2 * (∑ j, r j * delta j)) ≤
      (∑ j, r j ^ 2) - cutoffSq + cap := by
  have heq := contact_distance_expansion r delta
  linarith

/-- Summing rational row-inequality certificates with nonnegative weights
preserves their direction. This is the Farkas composition step. -/
theorem weighted_linear_inequalities {k m : ℕ}
    (rows : Fin k → Fin m → ℚ) (rhs weight : Fin k → ℚ)
    (delta : Fin m → ℚ)
    (hw : ∀ i, 0 ≤ weight i)
    (hr : ∀ i, (∑ j, rows i j * delta j) ≤ rhs i) :
    (∑ j, (∑ i, weight i * rows i j) * delta j) ≤
      ∑ i, weight i * rhs i := by
  have hsum :
      (∑ i, weight i * (∑ j, rows i j * delta j)) ≤
        ∑ i, weight i * rhs i := by
    apply Finset.sum_le_sum
    intro i _
    exact mul_le_mul_of_nonneg_left (hr i) (hw i)
  have rearrange :
      (∑ i, weight i * (∑ j, rows i j * delta j)) =
      (∑ j, (∑ i, weight i * rows i j) * delta j) := by
    simp [Finset.mul_sum, Finset.sum_mul, Finset.sum_comm, mul_assoc]
  rw [rearrange] at hsum
  exact hsum

/-- A witness whose EXACT rational weighted rows and bounds satisfy
`checkLinearNoGood` soundly excludes the entire proposed assignment. -/
theorem weighted_geometric_nogood_sound {k m : ℕ}
    (eps : ℚ) (rows : Fin k → Fin m → ℚ)
    (rhs weight : Fin k → ℚ) (delta : Fin m → ℚ)
    (hw : ∀ i, 0 ≤ weight i)
    (hr : ∀ i, (∑ j, rows i j * delta j) ≤ rhs i)
    (hbox : ∀ j, |delta j| ≤ eps)
    (hgate : checkLinearNoGood eps
      (fun j => ∑ i, weight i * rows i j)
      (∑ i, weight i * rhs i) = true) : False := by
  apply checkLinearNoGood_sound eps
    (fun j => ∑ i, weight i * rows i j) delta
    (∑ i, weight i * rhs i) hgate hbox
  exact weighted_linear_inequalities rows rhs weight delta hw hr

end FoldBounds.MotionGNMGeometricNogoods